{
  "name": "application",
  "version": "0.0.1",
  "description": "EdForge EMIS - Core Microservices (Identity, Academics)",
  "author": "EdForge",
  "private": true,
  "license": "MIT-0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:identity": "nest build identity",
    "build:academics": "nest build academics",
    "build:finance": "nest build finance",
    "start": "nest start",
    "start:identity": "node dist/microservices/identity/main",
    "start:academics": "node dist/microservices/academics/main",
    "start:finance": "node dist/microservices/finance/main",
    "start:dev:identity": "nest start identity --watch",
    "start:dev:academics": "nest start academics --watch",
    "start:dev:finance": "nest start finance --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:identity": "jest --config microservices/identity/jest.config.js",
    "test:academics": "jest --config microservices/academics/jest.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "lint": "eslint \"{src,apps,libs,microservices}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,apps,libs,microservices}/**/*.ts\""
  },
  "dependencies": {
    "@aibrains/pdf-renderer": "^0.6.0",
    "@aibrains/shared-types": "^0.61.0",
    "@react-pdf/renderer": "^3.4.5",
    "@aws-sdk/client-cognito-identity-provider": "^3.651.1",
    "@aws-sdk/client-dynamodb": "^3.651.1",
    "@aws-sdk/client-eventbridge": "^3.908.0",
    "@aws-sdk/client-s3": "^3.651.1",
    "@aws-sdk/client-sts": "^3.651.1",
    "@aws-sdk/lib-dynamodb": "^3.651.1",
    "@aws-sdk/s3-request-presigner": "^3.651.1",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/swagger": "^7.4.2",
    "axios": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "jwks-rsa": "^3.1.0",
    "nestjs-zod": "~4.3.1",
    "passport": "^0.7.0",
    "react": "^18.3.1",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "zod": "~3.24.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.11",
    "@types/jest": "^29.5.1",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.5.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^8.0.18",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^5.3.0"
  }
}
