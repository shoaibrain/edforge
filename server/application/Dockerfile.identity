# Dockerfile for identity microservice
# Build context: monorepo root (edforge/)
#
# @aibrains/shared-types is installed from npm as a standard dependency.

# Stage 1: Build identity service
FROM node:20-alpine AS build
WORKDIR /app
RUN apk update && apk upgrade

# Copy application package files
COPY server/application/package.json ./

# Install dependencies (build stage — needs dev deps for tsc/nest build).
# --legacy-peer-deps: @nestjs/schematics (dev) has a peer on typescript;
#   npm 10's strict resolver fails without this flag on cold installs.
# --omit=optional: skips platform-specific optional deps we don't need.
RUN npm install --legacy-peer-deps --omit=optional

# Copy application source
COPY server/application .

# Build the identity service
RUN npm run build identity

# Stage 2: Runtime
FROM node:20-alpine
WORKDIR /app
RUN apk update && apk upgrade

# Copy application package files
COPY server/application/package.json ./

# Install production dependencies only.
# --omit=dev: replaces deprecated --production=true (npm 10+).
# --legacy-peer-deps: @nestjs/schematics (dev) declares a peer on typescript
#   which itself is a dev dep — when we prune dev deps here, npm's strict
#   resolver sees `typescript@undefined` and fails. This flag tells npm to
#   keep the permissive (npm 6) resolution behavior for peers, matching the
#   pattern AdminWeb's CodePipeline uses (see CLAUDE.md publish-gate rules).
# --omit=optional: skip platform-specific optional deps we don't need.
RUN npm install --omit=dev --omit=optional --legacy-peer-deps && npm cache clean --force

# Copy built artifacts
COPY --from=build /app/dist ./dist
COPY --from=build /app/libs ./libs

EXPOSE 3010
CMD ["node", "dist/microservices/identity/main"]
