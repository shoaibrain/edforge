# Dockerfile for academics microservice
# Build context: monorepo root (edforge/)
#
# @aibrains/shared-types is installed from npm as a standard dependency.
#
# TODO (Sprint B cleanup — tracked, not blocking): this Dockerfile still uses
# the deprecated `npm install --production=true` pattern which cold-installs
# fail on npm 10 with ERESOLVE because @nestjs/schematics (dev) has a peer on
# typescript (dev). Dockerfile.identity was patched in Sprint B to use
# `--omit=dev --omit=optional --legacy-peer-deps` on the runtime stage and
# `--legacy-peer-deps --omit=optional` on the build stage. Apply the same
# pattern here on the next academics deploy. Not urgent because most builds
# hit the Docker layer cache; surfaces only on cold runs after a prune.

# Stage 1: Build academics service
FROM node:20-alpine AS build
WORKDIR /app
RUN apk update && apk upgrade

# Copy application package files
COPY server/application/package.json ./

# Install dependencies
RUN npm install --production=false

# Copy application source
COPY server/application .

# Build the academics service
RUN npm run build academics

# Stage 2: Runtime
FROM node:20-alpine
WORKDIR /app
RUN apk update && apk upgrade

# Copy application package files
COPY server/application/package.json ./

# Install production dependencies only
RUN npm install --production=true && npm cache clean --force

# Copy built artifacts
COPY --from=build /app/dist ./dist
COPY --from=build /app/libs ./libs

EXPOSE 3010
CMD ["node", "dist/microservices/academics/main"]
