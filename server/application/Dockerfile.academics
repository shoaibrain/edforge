# Dockerfile for academics microservice
# Build context: monorepo root (edforge/)
# Note: package.json includes @edforge/shared-types as dependency,
# but academics service doesn't currently use it. However, we need to handle
# the file: dependency for npm install to work.
# For now, we use npm install (not npm ci) to allow file: dependency resolution.
FROM node:20-alpine AS build
WORKDIR /app
RUN apk update && apk upgrade
COPY server/application/package.json server/application/package-lock.json ./
RUN npm install --production=false
COPY server/application .
RUN npm run build academics

# Runtime
FROM node:20-alpine
WORKDIR /app
RUN apk update && apk upgrade
COPY server/application/package.json server/application/package-lock.json ./
RUN npm install --production=true && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/libs ./libs
EXPOSE 3010
CMD ["node", "dist/microservices/academics/main"]
