# ============================================================
# EdForge NGINX Reverse Proxy Configuration
# ============================================================
# 
# ARCHITECTURE:
# This NGINX instance runs as a sidecar container in ECS alongside 
# the Identity and Academics services. It receives requests from the 
# ALB via the tenantPath header and routes them to the appropriate 
# internal service using ECS Service Connect DNS names.
#
# REQUEST FLOW:
# Client → API Gateway → NLB → ALB → NGINX (rproxy) → Service
#
# SERVICE ROUTING:
# - Identity Service (identity-api): /auth, /users, /schools, /tenants, /education-organizations,
#                                    /staff, /credentials, /admin, /sessions, /iemis
# - Academics Service (academics-api): /academics/students, /academics/enrollments, /academics/attendance
# - Finance Service (finance-api): /finance/schools/*/fee-structures, /finance/schools/*/invoices, /finance/schools/*/payments
#
# DNS FORMAT: {service-name}.{namespace}.sc:3010
# - The ${NAMESPACE} variable is substituted at container startup
# - .sc suffix indicates ECS Service Connect
# ============================================================

events {
  worker_connections 1024;
}

http {
  # Enable gzip compression for API responses
  gzip on;
  gzip_proxied any;
  gzip_types text/plain application/json;
  gzip_min_length 1000;

  server {
    listen 80;
    server_name localhost;

    # Default root - serves static health check page
    location / {
      root    /usr/share/nginx/html;
      index   index.html index.htm;
    }

    # Health check endpoint for ALB target group
    location = /health {
      add_header 'Content-Type' 'application/json';
      return 200 '{"status":"ok"}';
    }

    # ============================================================
    # IDENTITY SERVICE ROUTES
    # Service: identity-api.${NAMESPACE}.sc:3010
    # Domains: Auth, Users, Schools, Tenants, EdOrgs, Staff, Credentials, Leave
    # ============================================================

    # Authentication: login, logout, refresh, session
    location ~ ^/auth {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # User management: CRUD, authentication, role assignment
    location ~ ^/users {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # School management: CRUD, configuration
    location ~ ^/schools {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Tenant management: lookup, configuration
    location ~ ^/tenants {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # School Years: tenant-wide academic year aggregation
    location ~ ^/school-years {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Education Organizations: SEA, LEA, ESC hierarchy and CRUD
    location ~ ^/education-organizations {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Staff management: CRUD, credentials, leave requests (Ed-Fi aligned)
    location ~ ^/staff {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Credentials: staff credential/certification management
    location ~ ^/credentials {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Admin operations: cleanup, maintenance
    location ~ ^/admin {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Roles admin: tenant-wide role maintenance (RolesAdminController,
    # @Controller('roles')) — a NEW top-level prefix NOT covered by ^/users.
    location ~ ^/roles {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Sessions: user session management
    location ~ ^/sessions {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # IEMIS (Nepal CEHRD compliance): verify-school-code, audit log
    # Sprint 1 S1.5 + S1.10 — registered here 2026-04-23 after smoke revealed the gap.
    location ~ ^/iemis {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # ============================================================
    # ACADEMICS SERVICE ROUTES
    # Service: academics-api.${NAMESPACE}.sc:3010
    # Domains: Students, Enrollment, Attendance
    # All routes under /academics prefix
    # ============================================================

    # Academics API - all academic service routes
    location ~ ^/academics {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://academics-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # ============================================================
    # FINANCE SERVICE ROUTES
    # Service: finance-api.${NAMESPACE}.sc:3010
    # Domains: Fee Structures, Invoicing, Payments, Student Accounts, Gateway Config
    # All routes under /finance prefix
    # ============================================================

    # Finance API - all finance service routes
    location ~ ^/finance {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://finance-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # ============================================================
    # Archetype-aware holiday seed lookup (C3.3)
    # GET /holiday-seeds?archetype=&region=&year= — read-only data table.
    location ~ ^/holiday-seeds {
      if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Multi-day event blocks (C4.3) — CRUD over CalendarBlock + child CalendarDates.
    location ~ ^/calendar-blocks {
      if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PATCH|DELETE)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # Archetype defaults lookup (Sprint 0.4) — read-only data table; foundation for EPIC-D.
    # GET /archetype-defaults?archetype= — resolves PABSON/GENERIC academic policy defaults.
    location ~ ^/archetype-defaults {
      if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # External reporting — CEHRD IEMIS Flash I/II + future authorities (Sprint E.1).
    # POST /reporting/snapshots                       — create + trigger Lambda
    # POST /reporting/snapshots/preflight             — sync validation
    # GET  /reporting/snapshots                       — list a school's snapshots
    # GET  /reporting/snapshots/{snapshotId}          — read state
    # GET  /reporting/snapshots/{snapshotId}/download — presigned CSV URL
    # PATCH /reporting/snapshots/{id}/transition      — Lambda + operator UI
    location ~ ^/reporting {
      if ($request_method !~ ^(GET|POST|PATCH|HEAD|OPTIONS)$) {
        return 405;
      }
      proxy_pass http://identity-api.${NAMESPACE}.sc:3010;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
    }

    # FUTURE SERVICES (Return 501 Not Implemented)
    # These routes are placeholders for services planned in future phases
    # ============================================================

    location ~ ^/parents {
      add_header 'Content-Type' 'application/json' always;
      return 501 '{"error":"Not Implemented","service":"parent-portal","message":"Parent portal is planned for Phase 3"}';
    }

  }
}
