{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "resolveJsonModule": true,
    "paths": {
      "@app/auth": [
        "libs/auth/src"
      ],
      "@app/auth/*": [
        "libs/auth/src/*"
      ],
      "@app/client-factory": [
        "libs/client-factory/src"
      ],
      "@app/client-factory/*": [
        "libs/client-factory/src/*"
      ],
      "@app/common-utils": [
        "libs/common-utils/src"
      ],
      "@app/common-utils/*": [
        "libs/common-utils/src/*"
      ],
      "@app/http-client": [
        "libs/http-client/src"
      ],
      "@app/http-client/*": [
        "libs/http-client/src/*"
      ],
      "@app/csv-parser": [
        "libs/csv-parser/src"
      ],
      "@app/csv-parser/*": [
        "libs/csv-parser/src/*"
      ],
      "@app/cache": [
        "libs/cache/src"
      ],
      "@app/cache/*": [
        "libs/cache/src/*"
      ],
      "@app/aws-mocks": [
        "libs/aws-mocks/src"
      ],
      "@app/aws-mocks/*": [
        "libs/aws-mocks/src/*"
      ],
      "@app/test-utils": [
        "libs/test-utils/src"
      ],
      "@app/test-utils/*": [
        "libs/test-utils/src/*"
      ],
      "@app/events": [
        "libs/events/src"
      ],
      "@app/events/*": [
        "libs/events/src/*"
      ],
      "@app/logger": [
        "libs/logger/src"
      ],
      "@app/logger/*": [
        "libs/logger/src/*"
      ],
      "@app/exceptions": [
        "libs/exceptions/src"
      ],
      "@app/exceptions/*": [
        "libs/exceptions/src/*"
      ],
      "@app/health": [
        "libs/health/src"
      ],
      "@app/health/*": [
        "libs/health/src/*"
      ],
      "@edforge/shared-types": [
        "../../packages/shared-types/src"
      ],
      "@edforge/shared-types/*": [
        "../../packages/shared-types/src/*"
      ]
    }
  }
}