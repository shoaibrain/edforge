{
  "$schema": "https://json.schemastore.org/nest-cli",
  "_comment": "EdForge EMIS - NestJS Build Configuration for Core Services",
  "collection": "@nestjs/schematics",
  "sourceRoot": "microservices/identity/src",
  "monorepo": true,
  "root": "microservices/identity",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "microservices/identity/tsconfig.app.json"
  },
  "projects": {
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json",
        "assets": [
          "**/*.json"
        ]
      }
    },
    "client-factory": {
      "type": "library",
      "root": "libs/client-factory",
      "entryFile": "index",
      "sourceRoot": "libs/client-factory/src",
      "compilerOptions": {
        "tsConfigPath": "libs/client-factory/tsconfig.lib.json"
      }
    },
    "common-utils": {
      "type": "library",
      "root": "libs/common-utils",
      "entryFile": "index",
      "sourceRoot": "libs/common-utils/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common-utils/tsconfig.lib.json"
      }
    },
    "cache": {
      "type": "library",
      "root": "libs/cache",
      "entryFile": "index",
      "sourceRoot": "libs/cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cache/tsconfig.lib.json"
      }
    },
    "exceptions": {
      "type": "library",
      "root": "libs/exceptions",
      "entryFile": "index",
      "sourceRoot": "libs/exceptions/src",
      "compilerOptions": {
        "tsConfigPath": "libs/exceptions/tsconfig.lib.json"
      }
    },
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "entryFile": "index",
      "sourceRoot": "libs/logger/src",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "events": {
      "type": "library",
      "root": "libs/events",
      "entryFile": "index",
      "sourceRoot": "libs/events/src",
      "compilerOptions": {
        "tsConfigPath": "libs/events/tsconfig.lib.json"
      }
    },
    "http-client": {
      "type": "library",
      "root": "libs/http-client",
      "entryFile": "index",
      "sourceRoot": "libs/http-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/http-client/tsconfig.lib.json"
      }
    },
    "health": {
      "type": "library",
      "root": "libs/health",
      "entryFile": "index",
      "sourceRoot": "libs/health/src",
      "compilerOptions": {
        "tsConfigPath": "libs/health/tsconfig.lib.json"
      }
    },
    "test-utils": {
      "type": "library",
      "root": "libs/test-utils",
      "entryFile": "index",
      "sourceRoot": "libs/test-utils/src",
      "compilerOptions": {
        "tsConfigPath": "libs/test-utils/tsconfig.lib.json"
      }
    },
    "identity": {
      "type": "application",
      "root": "microservices/identity",
      "entryFile": "main",
      "sourceRoot": "microservices/identity/src",
      "compilerOptions": {
        "tsConfigPath": "microservices/identity/tsconfig.app.json"
      }
    },
    "academics": {
      "type": "application",
      "root": "microservices/academics",
      "entryFile": "main",
      "sourceRoot": "microservices/academics/src",
      "compilerOptions": {
        "tsConfigPath": "microservices/academics/tsconfig.app.json"
      }
    },
    "finance": {
      "type": "application",
      "root": "microservices/finance",
      "entryFile": "main",
      "sourceRoot": "microservices/finance/src",
      "compilerOptions": {
        "tsConfigPath": "microservices/finance/tsconfig.app.json"
      }
    }
  }
}
