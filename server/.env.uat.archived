# UAT Environment Configuration
# Backend: AWS account 715860911762 (profile: uat), us-east-2
# Frontend: https://uat.edforge.app (Vercel UAT environment)
# Developer: http://localhost:3000 also allowed for CORS
# DO NOT use edforge.app here — that domain is reserved for production

# Required: System Admin Email
CDK_PARAM_SYSTEM_ADMIN_EMAIL=shoaib.rain1@gmail.com

# Optional: Infrastructure Configuration
CDK_PARAM_USE_EC2_BASIC=false
CDK_PARAM_USE_EC2_ADVANCED=true
CDK_PARAM_USE_RPROXY=true

# Optional: Tenant Configuration
CDK_PARAM_TENANT_ID=basic
CDK_PARAM_TENANT_NAME=basic
CDK_PARAM_STAGE=prod
CDK_PARAM_USE_FEDERATION=true
CDK_PARAM_TIER=basic

# Optional: Advanced Cluster Configuration
CDK_ADV_CLUSTER=INACTIVE

# Optional: Enable CDK Nag for security checks
CDK_NAG_ENABLED=true

# Client Application URL (used in Cognito email templates)
CDK_PARAM_CLIENT_APP_URL=https://uat.edforge.app

# CORS Allowed Origins (comma-separated)
CDK_PARAM_CORS_ALLOWED_ORIGINS=https://uat.edforge.app,http://localhost:3000
