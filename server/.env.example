# CDK Environment Variables
# Copy this file to .env and set your actual values

# Required: System Admin Email
CDK_PARAM_SYSTEM_ADMIN_EMAIL=admin@example.com

# Optional: Infrastructure Configuration
CDK_PARAM_USE_EC2_BASIC=false
CDK_PARAM_USE_EC2_ADVANCED=true
CDK_PARAM_USE_RPROXY=true

# Optional: Tenant Configuration
CDK_PARAM_TENANT_ID=basic
CDK_PARAM_TENANT_NAME=basic
CDK_PARAM_STAGE=prod
CDK_PARAM_USE_FEDERATION=true
CDK_PARAM_TIER=basic

# Optional: Advanced Cluster Configuration
CDK_ADV_CLUSTER=INACTIVE

# Optional: Enable CDK Nag for security checks
CDK_NAG_ENABLED=true

# Optional: Operator alert email (SES bounce/complaint alarms, provisioning +
# analytics alerts). Falls back to CDK_PARAM_SYSTEM_ADMIN_EMAIL when unset.
CDK_PARAM_OPERATOR_ALERT_EMAIL=alerts@example.com

# ── Account email via Amazon SES ──────────────────────────────────────────
# The shared SES sending identity (sending domain + DKIM/SPF/DMARC + config set)
# is created ONLY when CDK_PARAM_SES_HOSTED_ZONE_ID is set (Route53 zone id for
# the parent domain). Until then no SES resources are synthesized. Sending via
# SES is gated SEPARATELY by CDK_PARAM_SES_ENABLED at the Cognito pools (default
# false). See docs/pilot-greenlight/email-reliability-ses-sprint-plan.md.
CDK_PARAM_SES_HOSTED_ZONE_ID=
CDK_PARAM_SES_HOSTED_ZONE_NAME=edforge.app
CDK_PARAM_SES_SENDING_DOMAIN=mail.edforge.app
CDK_PARAM_SES_MAIL_FROM_DOMAIN=bounce.mail.edforge.app
CDK_PARAM_SES_DMARC_RUA=dmarc@example.com
CDK_PARAM_SES_FROM_EMAIL=no-reply@mail.edforge.app
CDK_PARAM_SES_FROM_NAME=EdForge
CDK_PARAM_SES_REPLY_TO=support@example.com
CDK_PARAM_SES_ENABLED=false