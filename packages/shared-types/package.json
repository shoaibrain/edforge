{
  "name": "@aibrains/shared-types",
  "version": "0.87.0",
  "description": "Shared Zod schemas, TypeScript types, and validators for Education data models.",
  "license": "BUSL-1.1",
  "author": "Edforge Technologies LLC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas/analytics": {
      "types": "./dist/schemas/analytics/index.d.ts",
      "require": "./dist/schemas/analytics/index.js",
      "default": "./dist/schemas/analytics/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "require": "./dist/schemas/*.js",
      "default": "./dist/schemas/*.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "require": "./dist/validators/index.js",
      "default": "./dist/validators/index.js"
    },
    "./mappers": {
      "types": "./dist/mappers/index.d.ts",
      "require": "./dist/mappers/index.js",
      "default": "./dist/mappers/index.js"
    },
    "./utils/currency": {
      "types": "./dist/utils/currency.d.ts",
      "require": "./dist/utils/currency.js",
      "default": "./dist/utils/currency.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "prepare": "tsc",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "zod": "~3.24.4"
  },
  "peerDependencies": {
    "zod": ">=3.22.0 <3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
