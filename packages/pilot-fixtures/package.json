{
  "name": "@edforge/pilot-fixtures",
  "version": "0.0.1",
  "description": "Parametric pilot-fixtures package for EdForge. Engine knows zero pilots; pilots are JSON data dropped under pilots/<pilot-id>/. Workspace-only, NEVER published to npm.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "pilots"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "prepare": "tsc"
  },
  "dependencies": {
    "zod": "~3.24.4"
  },
  "devDependencies": {
    "@aibrains/shared-types": "^0.47.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
