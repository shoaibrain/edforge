{
  "compilerOptions": {
    "target": "ES2019",
    "module": "node16",
    "lib": ["ES2019", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "fonts", "scripts", "src/**/__tests__", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
